{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yuzi.local/schemas/project.schema.json",
  "title": "Yuzi Beautify Source Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tablesFile",
    "manifest",
    "files"
  ],
  "properties": {
    "tablesFile": {
      "$ref": "#/definitions/projectPath"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "author",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/item"
          }
        },
        "displays": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/display"
          }
        }
      }
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/packagePath"
      },
      "additionalProperties": {
        "$ref": "#/definitions/projectPath"
      }
    },
    "mimeTypes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/packagePath"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "encodings": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/packagePath"
      },
      "additionalProperties": {
        "enum": [
          "text",
          "base64"
        ]
      }
    }
  },
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\?#\\x00-\\x1F\\x7F])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\?#\\x00-\\x1F\\x7F])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableName",
        "fields"
      ],
      "properties": {
        "tableName": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mount"
      ],
      "properties": {
        "html": {
          "$ref": "#/definitions/packagePath"
        },
        "css": {
          "$ref": "#/definitions/packagePath"
        },
        "mount": {
          "$ref": "#/definitions/packagePath"
        }
      }
    },
    "imageCanvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableName",
        "stableIdentityFields",
        "canvas",
        "promptFields"
      ],
      "properties": {
        "tableName": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "stableIdentityFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "canvas": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "promptFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "promptSuffix": {
          "type": "string",
          "description": "经用户确认的构图要求与可选补充描述；追加到表格字段描述，不代表出图尺寸参数。"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "entry",
        "assets"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "name": {
          "type": "string"
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "entry": {
          "$ref": "#/definitions/entry"
        },
        "assets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/packagePath"
          }
        },
        "integrations": {
          "$ref": "#/definitions/integrations"
        },
        "imageGeneration": {
          "$ref": "#/definitions/imageGeneration"
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "targets",
        "entry",
        "assets"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "name": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "kind": {
          "enum": [
            "inline",
            "popup",
            "barrage"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/target"
          }
        },
        "entry": {
          "$ref": "#/definitions/entry"
        },
        "assets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/packagePath"
          }
        },
        "integrations": {
          "$ref": "#/definitions/integrations"
        },
        "imageGeneration": {
          "$ref": "#/definitions/imageGeneration"
        },
        "interactions": {
          "$ref": "#/definitions/interactions"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "inline"
              }
            }
          },
          "then": {},
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "imageGeneration"
                  ]
                },
                {
                  "required": [
                    "interactions"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "theme": {
          "const": true
        },
        "font": {
          "const": true
        }
      }
    },
    "imageGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvases"
      ],
      "properties": {
        "canvases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/imageCanvas"
          }
        }
      }
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "expand",
          "tabs",
          "append-input",
          "image-generate"
        ]
      }
    }
  }
}
